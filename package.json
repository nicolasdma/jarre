{
  "name": "jarre-app",
  "version": "0.1.0",
  "description": "Curriculum-first learning platform with AI-assisted study, evaluation, and voice tutoring.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "clean:next": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});console.log('Cleaned .next')\"",
    "dev:clean": "npm run clean:next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck && npm run build",
    "engine": "tsx engine/src/server.ts",
    "engine:dev": "tsx watch engine/src/server.ts",
    "test": "vitest run",
    "curriculum:audit": "tsx scripts/audit-curriculum.ts",
    "curriculum:export-template": "tsx scripts/export-curriculum-template.ts",
    "e2e:up": "node e2e/scripts/up.mjs",
    "e2e:down": "node e2e/scripts/down.mjs",
    "e2e:server": "node e2e/scripts/server.mjs",
    "e2e:local": "node e2e/scripts/run.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.41.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "codemirror": "^6.0.2",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.34.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "stripe": "^20.3.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.183.0",
    "three-spritetext": "^1.10.0",
    "tldraw": "^4.3.1",
    "ts-fsrs": "^5.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.0",
    "eslint": "^9",
